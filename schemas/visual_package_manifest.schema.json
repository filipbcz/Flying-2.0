{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/visual_package_manifest.schema.json",
  "title": "Flying Offline Visual Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "packageName",
    "packageVersion",
    "coverage",
    "offlineRuntime",
    "sourceLineage",
    "transforms",
    "imagery",
    "vectorPackages",
    "materialMasks",
    "objectHeightMetadata",
    "validation"
  ],
  "properties": {
    "schemaVersion": {"const": "flying.visual-package-manifest.v1"},
    "packageId": {"type": "string", "minLength": 1},
    "packageName": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "countryCode", "bounds"],
      "properties": {
        "scope": {"const": "initial-visual-slice"},
        "countryCode": {"const": "CZ"},
        "bounds": {"$ref": "#/$defs/bounds"}
      }
    },
    "offlineRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeNetworkRequired",
        "externalMapApis",
        "remoteTileServers",
        "renderableWithNetworkingDisabled"
      ],
      "properties": {
        "runtimeNetworkRequired": {"const": false},
        "externalMapApis": {"type": "array", "maxItems": 0},
        "remoteTileServers": {"type": "array", "maxItems": 0},
        "renderableWithNetworkingDisabled": {"const": true}
      }
    },
    "sourceLineage": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/sourceLineageEntry"}
    },
    "transforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCrs", "targetCrs", "operations"],
      "properties": {
        "sourceCrs": {"$ref": "#/$defs/crs"},
        "targetCrs": {"$ref": "#/$defs/crs"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/transformOperation"}
        }
      }
    },
    "imagery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDatasetId", "format", "lods", "attribution"],
      "properties": {
        "sourceDatasetId": {"type": "string", "minLength": 1},
        "format": {"const": "ppm-p3"},
        "lods": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "sampleStride", "tiles"],
            "properties": {
              "level": {"type": "integer", "minimum": 0},
              "sampleStride": {"type": "integer", "minimum": 1},
              "tiles": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/fileArtifact"}
              }
            }
          }
        },
        "attribution": {"type": "string", "minLength": 1}
      }
    },
    "vectorPackages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roads", "railways", "water", "buildings", "vegetation", "objects", "labels"],
      "properties": {
        "roads": {
          "allOf": [
            {"$ref": "#/$defs/vectorLayer"},
            {"properties": {"category": {"const": "roads"}}}
          ]
        },
        "railways": {
          "allOf": [
            {"$ref": "#/$defs/vectorLayer"},
            {"properties": {"category": {"const": "railways"}}}
          ]
        },
        "water": {
          "allOf": [
            {"$ref": "#/$defs/vectorLayer"},
            {"properties": {"category": {"const": "water"}}}
          ]
        },
        "buildings": {
          "allOf": [
            {"$ref": "#/$defs/vectorLayer"},
            {"properties": {"category": {"const": "buildings"}}}
          ]
        },
        "vegetation": {
          "allOf": [
            {"$ref": "#/$defs/vectorLayer"},
            {"properties": {"category": {"const": "vegetation"}}}
          ]
        },
        "objects": {
          "allOf": [
            {"$ref": "#/$defs/vectorLayer"},
            {"properties": {"category": {"const": "objects"}}}
          ]
        },
        "labels": {
          "allOf": [
            {"$ref": "#/$defs/vectorLayer"},
            {"properties": {"category": {"const": "labels"}}}
          ]
        }
      }
    },
    "materialMasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileArtifact"}
    },
    "objectHeightMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDatasetId", "path", "checksum", "heightDerivation"],
      "properties": {
        "sourceDatasetId": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/localPath"},
        "checksum": {"$ref": "#/$defs/checksum"},
        "heightDerivation": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "checksumValidation",
        "requiredVectorCategories",
        "networkDisabledRenderValidation"
      ],
      "properties": {
        "passed": {"const": true},
        "checksumValidation": {"const": "passed"},
        "requiredVectorCategories": {
          "type": "array",
          "prefixItems": [
            {"const": "roads"},
            {"const": "railways"},
            {"const": "water"},
            {"const": "buildings"},
            {"const": "vegetation"},
            {"const": "objects"},
            {"const": "labels"}
          ],
          "minItems": 7,
          "maxItems": 7
        },
        "networkDisabledRenderValidation": {"const": "passed"}
      }
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!//)(?!.*://)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minEastM", "maxEastM", "minNorthM", "maxNorthM"],
      "properties": {
        "minEastM": {"type": "number"},
        "maxEastM": {"type": "number"},
        "minNorthM": {"type": "number"},
        "maxNorthM": {"type": "number"}
      }
    },
    "crs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "code", "name"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "transformOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "method"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "pipeline": {"type": "string", "minLength": 1}
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "checksum"],
      "properties": {
        "path": {"$ref": "#/$defs/localPath"},
        "checksum": {"$ref": "#/$defs/checksum"}
      }
    },
    "sourceLineageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "datasetName",
        "sourceVersion",
        "effectiveDate",
        "license",
        "attribution",
        "redistributionTerms",
        "checksum"
      ],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "datasetName": {"type": "string", "minLength": 1},
        "sourceVersion": {"type": "string", "minLength": 1},
        "effectiveDate": {"type": "string", "format": "date"},
        "license": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "redistributionTerms": {"type": "string", "minLength": 1},
        "checksum": {"$ref": "#/$defs/checksum"}
      }
    },
    "vectorLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "sourceDatasetId", "path", "featureCount", "checksum", "attribution"],
      "properties": {
        "category": {
          "enum": ["roads", "railways", "water", "buildings", "vegetation", "objects", "labels"]
        },
        "sourceDatasetId": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/localPath"},
        "featureCount": {"type": "integer", "minimum": 1},
        "checksum": {"$ref": "#/$defs/checksum"},
        "attribution": {"type": "string", "minLength": 1}
      }
    }
  }
}
