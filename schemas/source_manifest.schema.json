{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/source_manifest.schema.json",
  "title": "Flying Offline Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "sourceGroups"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.source-manifest.v1"
    },
    "manifestVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "sourceGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dmr",
        "dmp",
        "ortofoto",
        "zabaged",
        "geonames",
        "ucl",
        "aip",
        "vfr",
        "operator_inputs"
      ],
      "properties": {
        "dmr": {
          "$ref": "#/$defs/sourceGroup"
        },
        "dmp": {
          "$ref": "#/$defs/sourceGroup"
        },
        "ortofoto": {
          "$ref": "#/$defs/sourceGroup"
        },
        "zabaged": {
          "$ref": "#/$defs/sourceGroup"
        },
        "geonames": {
          "$ref": "#/$defs/sourceGroup"
        },
        "ucl": {
          "$ref": "#/$defs/sourceGroup"
        },
        "aip": {
          "$ref": "#/$defs/sourceGroup"
        },
        "vfr": {
          "$ref": "#/$defs/sourceGroup"
        },
        "operator_inputs": {
          "$ref": "#/$defs/sourceGroup"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sourceGroup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourcePackage"
      }
    },
    "sourcePackage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "version",
        "checksum",
        "crs",
        "transform",
        "license",
        "attribution",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "crs": {
          "$ref": "#/$defs/crs"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "path",
        "value"
      ],
      "properties": {
        "algorithm": {
          "pattern": "^[Ss][Hh][Aa]256$"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "crs": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "authority",
        "code",
        "name"
      ],
      "properties": {
        "authority": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verticalDatum": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sourceCrs",
        "targetCrs",
        "projPipeline",
        "gridFiles"
      ],
      "properties": {
        "sourceCrs": {
          "$ref": "#/$defs/crs"
        },
        "targetCrs": {
          "$ref": "#/$defs/crs"
        },
        "projPipeline": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "gridFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "spdxId",
        "redistributionTerms",
        "evidenceUri"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "spdxId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "redistributionTerms": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceUri": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "statement",
        "requiredInProduct"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requiredInProduct": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "publisher",
        "sourceUri",
        "retrievedAtUtc",
        "packageId",
        "effectiveDate"
      ],
      "properties": {
        "publisher": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceUri": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retrievedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "packageId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "effectiveDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
