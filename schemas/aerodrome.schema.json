{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/aerodrome.schema.json",
  "title": "Flying Aerodrome Runway Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "databaseVersion",
    "airac",
    "aerodromes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.aerodrome-database.v1"
    },
    "databaseVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "airac": {
      "$ref": "#/$defs/airacVersion"
    },
    "aerodromes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aerodrome"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "dateString": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "airacVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycleId",
        "effectiveDate",
        "source"
      ],
      "properties": {
        "cycleId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "effectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "wgs84Position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latDeg",
        "lonDeg",
        "elevationM"
      ],
      "properties": {
        "latDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lonDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevationM": {
          "type": "number"
        }
      }
    },
    "sourceAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType",
        "publisher",
        "permissionStatus",
        "effectiveDate",
        "retrievedAtUtc",
        "checksum"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "operator_confirmation",
            "geodetic_survey",
            "cuzk_derived_measurement",
            "public_register_checklist",
            "project_fixture",
            "restricted_aip_pending_permission"
          ]
        },
        "publisher": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceDocument": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "license": {
          "type": "object"
        },
        "permissionStatus": {
          "type": "string",
          "enum": [
            "permitted",
            "pending_permission",
            "blocked_missing_permission",
            "blocked_missing_source_data"
          ]
        },
        "effectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "retrievedAtUtc": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "accuracyM": {
          "type": "number",
          "minimum": 0
        },
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        },
        "transformMetadata": {
          "type": "object"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall",
        "geometry",
        "surface",
        "declaredDistances"
      ],
      "properties": {
        "overall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "geometry": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surface": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "declaredDistances": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "manualVerification"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "derived",
            "manually_verified",
            "production_validated",
            "blocked_missing_permission",
            "blocked_missing_source_data"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "manualVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "unverified",
                "reviewer_approved",
                "rejected",
                "blocked",
                "not_required"
              ]
            },
            "reviewer": {
              "type": "string"
            },
            "verifiedAtUtc": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "aerodrome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "classification",
        "operationalStatus",
        "referencePointWgs84",
        "airacEffectiveDate",
        "sourceAttribution",
        "validation",
        "runways"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "icaoCode": {
          "type": "string"
        },
        "localCode": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "classification": {
          "type": "string",
          "enum": [
            "active_airport",
            "slz_field",
            "closed_field"
          ]
        },
        "operationalStatus": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "closed",
            "unknown"
          ]
        },
        "referencePointWgs84": {
          "$ref": "#/$defs/wgs84Position"
        },
        "trafficPatternAltitudeFtAgl": {
          "type": "number",
          "minimum": 0
        },
        "airacEffectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "sourceAttribution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceAttribution"
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "runways": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runway"
          }
        },
        "startLocationEligibility": {
          "type": "object"
        }
      }
    },
    "runway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "designator",
        "surface",
        "dimensionsM",
        "lighting",
        "markings",
        "slope",
        "airacEffectiveDate",
        "sourceAttribution",
        "validation",
        "geometryReview",
        "ends"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "designator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "surface": {
          "type": "object"
        },
        "dimensionsM": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "width"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "lighting": {
          "type": "object"
        },
        "markings": {
          "type": "object"
        },
        "slope": {
          "type": "object"
        },
        "airacEffectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "sourceAttribution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceAttribution"
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "geometryReview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manualOverwriteRequiresReview"
          ],
          "properties": {
            "manualOverwriteRequiresReview": {
              "type": "boolean"
            },
            "reviewTicket": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/runwayEnd"
          }
        }
      }
    },
    "runwayEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "designator",
        "trueBearingDeg",
        "threshold",
        "declaredDistancesM",
        "sourceAttribution",
        "validation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "designator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trueBearingDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "geometrySource",
            "physicalThreshold"
          ],
          "properties": {
            "geometrySource": {
              "type": "string",
              "enum": [
                "threshold_geometry",
                "approved_derived_measurement"
              ]
            },
            "physicalThreshold": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "positionWgs84",
                "sourceAccuracyM",
                "provenanceRef"
              ],
              "properties": {
                "positionWgs84": {
                  "$ref": "#/$defs/wgs84Position"
                },
                "sourceAccuracyM": {
                  "type": "number",
                  "minimum": 0
                },
                "provenanceRef": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            },
            "displacedThreshold": {
              "type": "object"
            },
            "approvedDerivedMeasurement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "approved",
                "method",
                "reviewer",
                "reviewedAtUtc",
                "sourceAttribution"
              ],
              "properties": {
                "approved": {
                  "const": true
                },
                "method": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "reviewer": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "reviewedAtUtc": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "sourceAttribution": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/sourceAttribution"
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "geometrySource"
                ],
                "properties": {
                  "geometrySource": {
                    "const": "approved_derived_measurement"
                  }
                }
              },
              "then": {
                "required": [
                  "approvedDerivedMeasurement"
                ]
              }
            }
          ]
        },
        "declaredDistancesM": {
          "type": "object"
        },
        "lighting": {
          "type": "object"
        },
        "markings": {
          "type": "object"
        },
        "slope": {
          "type": "object"
        },
        "sourceAttribution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceAttribution"
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      }
    }
  }
}
