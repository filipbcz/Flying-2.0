{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/package-manifest.schema.json",
  "title": "Flying GIS Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "packageVersion",
    "packageId",
    "contentHash",
    "sourceManifestVersion",
    "transform",
    "sourceLineage",
    "determinism"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.package-manifest.v1"
    },
    "packageName": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-[a-f0-9]{16}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceManifestVersion": {
      "type": "string",
      "minLength": 1
    },
    "transform": {
      "type": "object"
    },
    "sourceLineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceLineageEntry"
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "identityInputHash"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "identityInputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sourceLineageEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sourceId",
        "datasetName",
        "version",
        "license",
        "attribution",
        "checksum",
        "coordinateReferenceSystem",
        "permittedUse",
        "provenance"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "datasetName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license": {
          "type": "object"
        },
        "attribution": {
          "type": "object"
        },
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "algorithm",
            "value"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "coordinateReferenceSystem": {
          "type": "object"
        },
        "permittedUse": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        }
      }
    }
  }
}
