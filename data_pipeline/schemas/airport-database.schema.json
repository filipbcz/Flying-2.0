{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/airport-database.schema.json",
  "title": "Flying Airport Database",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "databaseVersion",
    "airac",
    "metadata",
    "masterList",
    "aerodromes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.airport-database.v1"
    },
    "databaseVersion": {
      "type": "string",
      "minLength": 1
    },
    "airac": {
      "$ref": "#/$defs/airacVersion"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "restrictedSourcePolicy",
        "generatedAtUtc"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "pilot_airports_only",
            "national_airport_master_list"
          ]
        },
        "restrictedSourcePolicy": {
          "type": "string",
          "enum": [
            "no_aip_vfr_content_without_permission",
            "restricted_sources_permitted_by_archived_license"
          ]
        },
        "generatedAtUtc": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "masterList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/masterListRecord"
      }
    },
    "aerodromes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aerodrome"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "dateString": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "airacVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycleId",
        "effectiveDate",
        "source"
      ],
      "properties": {
        "cycleId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "effectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "wgs84Position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latDeg",
        "lonDeg",
        "elevationM"
      ],
      "properties": {
        "latDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lonDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevationM": {
          "type": "number"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sourceId",
        "sourceType",
        "publisher",
        "permissionStatus",
        "retrievedAtUtc"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "operator_confirmation",
            "geodetic_survey",
            "cuzk_derived_measurement",
            "project_fixture",
            "public_register_checklist",
            "restricted_aip_pending_permission"
          ]
        },
        "publisher": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceUrl": {
          "type": "string"
        },
        "sourceDocument": {
          "type": "string"
        },
        "license": {
          "type": "object"
        },
        "permissionStatus": {
          "type": "string",
          "enum": [
            "permitted",
            "pending_permission",
            "blocked_missing_permission",
            "blocked_missing_source_data"
          ]
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "retrievedAtUtc": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "accuracyM": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "validationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "confidence",
        "manualVerification"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "derived",
            "manually_verified",
            "production_validated",
            "blocked_missing_permission",
            "blocked_missing_source_data"
          ]
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overall",
            "geometry",
            "surface",
            "declaredDistances"
          ],
          "properties": {
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "geometry": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "surface": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "declaredDistances": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "manualVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "unverified",
                "reviewer_approved",
                "rejected",
                "blocked",
                "not_required"
              ]
            },
            "reviewer": {
              "type": "string"
            },
            "verifiedAtUtc": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "masterListRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aerodromeId",
        "name",
        "classification",
        "operationalStatus",
        "recordStatus",
        "sourceDataStatus",
        "airacEffectiveDate",
        "provenance",
        "validation"
      ],
      "properties": {
        "aerodromeId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "classification": {
          "type": "string",
          "enum": [
            "active_airport",
            "slz_field",
            "closed_field"
          ]
        },
        "operationalStatus": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "closed",
            "unknown"
          ]
        },
        "recordStatus": {
          "type": "string",
          "enum": [
            "validated",
            "derived",
            "blocked_missing_permission",
            "blocked_missing_source_data",
            "draft"
          ]
        },
        "sourceDataStatus": {
          "type": "string",
          "enum": [
            "permitted",
            "pending_permission",
            "blocked_missing_permission",
            "blocked_missing_source_data"
          ]
        },
        "airacEffectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "validation": {
          "$ref": "#/$defs/validationState"
        },
        "startLocationEligibility": {
          "$ref": "#/$defs/startLocationEligibility"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "aerodrome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "classification",
        "operationalStatus",
        "referencePointWgs84",
        "airacEffectiveDate",
        "provenance",
        "validation",
        "runways"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "icaoCode": {
          "type": "string"
        },
        "localCode": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "classification": {
          "type": "string",
          "enum": [
            "active_airport",
            "slz_field",
            "closed_field"
          ]
        },
        "operationalStatus": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "closed",
            "unknown"
          ]
        },
        "referencePointWgs84": {
          "$ref": "#/$defs/wgs84Position"
        },
        "trafficPatternAltitudeFtAgl": {
          "type": "number",
          "minimum": 0
        },
        "airacEffectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "validation": {
          "$ref": "#/$defs/validationState"
        },
        "startLocationEligibility": {
          "$ref": "#/$defs/startLocationEligibility"
        },
        "runways": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runway"
          }
        }
      }
    },
    "runway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "designator",
        "surface",
        "dimensionsM",
        "lighting",
        "markings",
        "slope",
        "airacEffectiveDate",
        "provenance",
        "validation",
        "ends"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "designator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "surface": {
          "$ref": "#/$defs/runwaySurface"
        },
        "dimensionsM": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length",
            "width"
          ],
          "properties": {
            "length": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "lighting": {
          "$ref": "#/$defs/runwayLighting"
        },
        "markings": {
          "$ref": "#/$defs/runwayMarkings"
        },
        "slope": {
          "$ref": "#/$defs/runwaySlope"
        },
        "airacEffectiveDate": {
          "$ref": "#/$defs/dateString"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "validation": {
          "$ref": "#/$defs/validationState"
        },
        "geometryReview": {
          "$ref": "#/$defs/geometryReview"
        },
        "ends": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/runwayEnd"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validation": {
                "properties": {
                  "status": {
                    "const": "production_validated"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "validation"
            ]
          },
          "then": {
            "required": [
              "provenance",
              "ends"
            ],
            "properties": {
              "provenance": {
                "type": "array",
                "minItems": 1
              },
              "ends": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "required": [
                    "threshold",
                    "provenance"
                  ],
                  "properties": {
                    "provenance": {
                      "type": "array",
                      "minItems": 1
                    },
                    "threshold": {
                      "required": [
                        "physicalThreshold"
                      ],
                      "properties": {
                        "physicalThreshold": {
                          "required": [
                            "positionWgs84"
                          ],
                          "properties": {
                            "positionWgs84": {
                              "required": [
                                "latDeg",
                                "lonDeg",
                                "elevationM"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "runwaySurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceType",
        "material",
        "condition"
      ],
      "properties": {
        "surfaceType": {
          "type": "string",
          "enum": [
            "paved",
            "grass",
            "unsealed",
            "water",
            "unknown"
          ]
        },
        "material": {
          "type": "string",
          "enum": [
            "asphalt",
            "concrete",
            "grass",
            "turf",
            "gravel",
            "soil",
            "composite",
            "unknown"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "serviceable",
            "limited",
            "closed",
            "unknown"
          ]
        },
        "loadRating": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "startLocationEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultStartLocation",
        "historicalModeOnly"
      ],
      "properties": {
        "defaultStartLocation": {
          "type": "boolean"
        },
        "historicalModeOnly": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "geometryReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manualOverwriteRequiresReview"
      ],
      "properties": {
        "manualOverwriteRequiresReview": {
          "type": "boolean"
        },
        "reviewTicket": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "runwayLighting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeLights",
        "thresholdLights",
        "approachLights",
        "papi",
        "runwayEndIdentifierLights"
      ],
      "properties": {
        "edgeLights": {
          "type": "boolean"
        },
        "thresholdLights": {
          "type": "boolean"
        },
        "approachLights": {
          "type": "boolean"
        },
        "papi": {
          "type": "boolean"
        },
        "runwayEndIdentifierLights": {
          "type": "boolean"
        },
        "intensity": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "runwayMarkings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designator",
        "centerline",
        "threshold",
        "aimingPoint",
        "touchdownZone",
        "edge"
      ],
      "properties": {
        "designator": {
          "type": "boolean"
        },
        "centerline": {
          "type": "boolean"
        },
        "threshold": {
          "type": "boolean"
        },
        "aimingPoint": {
          "type": "boolean"
        },
        "touchdownZone": {
          "type": "boolean"
        },
        "edge": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "runwaySlope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitudinalPercent",
        "transversePercent"
      ],
      "properties": {
        "longitudinalPercent": {
          "type": "number"
        },
        "transversePercent": {
          "type": "number"
        },
        "sourceAccuracyPercent": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "runwayEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "designator",
        "trueBearingDeg",
        "threshold",
        "declaredDistancesM",
        "lighting",
        "markings",
        "slope",
        "provenance",
        "validation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "designator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trueBearingDeg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "threshold": {
          "$ref": "#/$defs/thresholdSet"
        },
        "declaredDistancesM": {
          "$ref": "#/$defs/declaredDistances"
        },
        "lighting": {
          "$ref": "#/$defs/runwayLighting"
        },
        "markings": {
          "$ref": "#/$defs/runwayMarkings"
        },
        "slope": {
          "$ref": "#/$defs/runwaySlope"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "validation": {
          "$ref": "#/$defs/validationState"
        }
      }
    },
    "thresholdSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalThreshold",
        "displacedThreshold"
      ],
      "properties": {
        "physicalThreshold": {
          "$ref": "#/$defs/threshold"
        },
        "displacedThreshold": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "present"
          ],
          "properties": {
            "present": {
              "type": "boolean"
            },
            "positionWgs84": {
              "$ref": "#/$defs/wgs84Position"
            },
            "offsetM": {
              "type": "number",
              "minimum": 0
            },
            "sourceAccuracyM": {
              "type": "number",
              "minimum": 0
            },
            "provenanceRef": {
              "type": "string"
            }
          }
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positionWgs84",
        "sourceAccuracyM",
        "provenanceRef"
      ],
      "properties": {
        "positionWgs84": {
          "$ref": "#/$defs/wgs84Position"
        },
        "sourceAccuracyM": {
          "type": "number",
          "minimum": 0
        },
        "provenanceRef": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "declaredDistances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tora",
        "toda",
        "asda",
        "lda",
        "provenanceRef"
      ],
      "properties": {
        "tora": {
          "type": "number",
          "minimum": 0
        },
        "toda": {
          "type": "number",
          "minimum": 0
        },
        "asda": {
          "type": "number",
          "minimum": 0
        },
        "lda": {
          "type": "number",
          "minimum": 0
        },
        "provenanceRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
