{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/pilot-runway-surfaces-package.schema.json",
  "title": "Flying Pilot Runway Surfaces Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "packageName",
    "packageVersion",
    "packageId",
    "airportDatabaseVersion",
    "coordinateFrame",
    "runtimeDependencies",
    "collision",
    "surfaces",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.pilot-runway-surfaces-package.v1"
    },
    "packageName": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "packageId": {"type": "string", "minLength": 1},
    "airportDatabaseVersion": {"type": "string", "minLength": 1},
    "coordinateFrame": {"const": "airport-local-ENU-per-aerodrome"},
    "runtimeDependencies": {
      "type": "object",
      "required": [
        "runtimeNetworkRequired",
        "externalMapApis",
        "remoteTileServerUrls"
      ],
      "properties": {
        "runtimeNetworkRequired": {"const": false},
        "externalMapApis": {"type": "array", "maxItems": 0},
        "remoteTileServerUrls": {"type": "array", "maxItems": 0}
      }
    },
    "collision": {
      "type": "object",
      "required": [
        "authority",
        "runwayOverridePriority",
        "genericTerrainPriority",
        "wheelContactToleranceM"
      ],
      "properties": {
        "authority": {"const": "runway_override"},
        "runwayOverridePriority": {"type": "integer", "minimum": 1},
        "genericTerrainPriority": {"type": "integer", "minimum": 1},
        "wheelContactToleranceM": {"type": "number", "maximum": 0.05}
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "airportId",
          "runwayId",
          "surfaceType",
          "file",
          "georeference",
          "material",
          "roughnessM",
          "visualMesh",
          "collisionMesh",
          "transitionBands",
          "provenance",
          "thresholdCoordinateLengthM",
          "longitudinalPercent",
          "transversePercent"
        ],
        "properties": {
          "airportId": {"type": "string", "minLength": 1},
          "runwayId": {"type": "string", "minLength": 1},
          "surfaceType": {"enum": ["paved", "grass"]},
          "file": {"type": "string", "minLength": 1},
          "thresholdCoordinateLengthM": {"type": "number", "exclusiveMinimum": 0},
          "longitudinalPercent": {"type": "number"},
          "transversePercent": {"type": "number"},
          "material": {"type": "string", "minLength": 1},
          "roughnessM": {"type": "number", "minimum": 0},
          "georeference": {
            "type": "object",
            "required": [
              "coordinateFrame",
              "originWgs84",
              "centerLocalEnuM",
              "centerWgs84",
              "trueHeadingDeg",
              "thresholds"
            ],
            "properties": {
              "coordinateFrame": {"const": "airport-local-ENU"},
              "originWgs84": {"$ref": "#/$defs/wgs84Position"},
              "centerLocalEnuM": {"$ref": "#/$defs/localEnu"},
              "centerWgs84": {"$ref": "#/$defs/wgs84Position"},
              "trueHeadingDeg": {"type": "number", "minimum": 0, "exclusiveMaximum": 360},
              "thresholds": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "required": ["id", "positionWgs84", "localEnuM"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "positionWgs84": {"$ref": "#/$defs/wgs84Position"},
                    "localEnuM": {"$ref": "#/$defs/localEnu"}
                  }
                }
              }
            }
          },
          "visualMesh": {"$ref": "#/$defs/surfaceMesh"},
          "collisionMesh": {"$ref": "#/$defs/surfaceMesh"},
          "transitionBands": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["side", "widthM", "innerHeightM", "outerHeightM", "terrainMaterial", "maxStepM"],
              "properties": {
                "side": {"enum": ["left", "right"]},
                "widthM": {"type": "number", "exclusiveMinimum": 0},
                "innerHeightM": {"type": "number"},
                "outerHeightM": {"type": "number"},
                "terrainMaterial": {"type": "string", "minLength": 1},
                "maxStepM": {"type": "number", "maximum": 0.05}
              }
            }
          },
          "provenance": {"type": "array", "minItems": 1}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "coverageReport",
        "coordinateChecksIncluded",
        "headingChecksIncluded",
        "dimensionChecksIncluded",
        "ortofotoAlignmentChecksIncluded",
        "terrainTransitionChecksIncluded",
        "provenanceChecksIncluded"
      ],
      "properties": {
        "coverageReport": {"type": "string"},
        "coordinateChecksIncluded": {"const": true},
        "headingChecksIncluded": {"const": true},
        "dimensionChecksIncluded": {"const": true},
        "ortofotoAlignmentChecksIncluded": {"const": true},
        "terrainTransitionChecksIncluded": {"const": true},
        "provenanceChecksIncluded": {"const": true}
      }
    }
  },
  "$defs": {
    "wgs84Position": {
      "type": "object",
      "required": ["latDeg", "lonDeg", "elevationM"],
      "properties": {
        "latDeg": {"type": "number", "minimum": -90, "maximum": 90},
        "lonDeg": {"type": "number", "minimum": -180, "maximum": 180},
        "elevationM": {"type": "number"}
      }
    },
    "localEnu": {
      "type": "object",
      "required": ["east", "north", "up"],
      "properties": {
        "east": {"type": "number"},
        "north": {"type": "number"},
        "up": {"type": "number"}
      }
    },
    "surfaceMesh": {
      "type": "object",
      "required": ["vertices", "indices"],
      "properties": {
        "vertices": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["stationM", "lateralM", "localEnuM", "positionWgs84", "heightM"],
            "properties": {
              "stationM": {"type": "number"},
              "lateralM": {"type": "number"},
              "localEnuM": {"$ref": "#/$defs/localEnu"},
              "positionWgs84": {"$ref": "#/$defs/wgs84Position"},
              "heightM": {"type": "number"}
            }
          }
        },
        "indices": {
          "type": "array",
          "minItems": 6,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
