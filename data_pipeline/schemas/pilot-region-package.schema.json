{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/pilot-region-package.schema.json",
  "title": "Flying Pilot Region Offline GIS Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "packageName",
    "packageVersion",
    "packageId",
    "contentHash",
    "sourceManifestVersion",
    "coverage",
    "sourceLineage",
    "pilotRegion",
    "runtimeDependencies",
    "imagery",
    "vectorPackages",
    "masks",
    "streaming",
    "packagingLayout",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.pilot-region-package.v1"
    },
    "packageName": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "packageId": {"type": "string", "minLength": 1},
    "contentHash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "sourceManifestVersion": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "required": ["scope", "countryCode", "completeWithinDeclaredBounds"],
      "properties": {
        "scope": {"enum": ["pilot-region", "czech-republic"]},
        "countryCode": {"const": "CZ"},
        "completeWithinDeclaredBounds": {"type": "boolean"}
      }
    },
    "sourceLineage": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "pilotRegion": {"type": "object"},
    "runtimeDependencies": {
      "type": "object",
      "required": [
        "runtimeNetworkRequired",
        "externalMapApis",
        "remoteTileServerUrls"
      ],
      "properties": {
        "runtimeNetworkRequired": {"const": false},
        "externalMapApis": {"type": "array", "maxItems": 0},
        "remoteTileServerUrls": {"type": "array", "maxItems": 0}
      }
    },
    "imagery": {
      "type": "object",
      "required": ["encoding", "tileSizePx", "mipmapped", "lods"],
      "properties": {
        "encoding": {"const": "ppm-p3"},
        "tileSizePx": {"type": "integer", "minimum": 1},
        "mipmapped": {"type": "boolean"},
        "lods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["level", "sourcePixelScale", "tiles"],
            "properties": {
              "level": {"type": "integer", "minimum": 0},
              "sourcePixelScale": {"type": "integer", "minimum": 1},
              "tiles": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/assetTile"}
              }
            }
          }
        }
      }
    },
    "vectorPackages": {
      "type": "object",
      "required": ["coordinateFrame", "layers", "labels"],
      "properties": {
        "coordinateFrame": {"const": "project-local-ENU"},
        "layers": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": ["category", "featureCount", "sourceId", "file"],
            "properties": {
              "category": {"type": "string"},
              "featureCount": {"type": "integer", "minimum": 0},
              "sourceId": {"type": "string"},
              "file": {"$ref": "#/$defs/fileMetadata"}
            }
          }
        },
        "labels": {
          "type": "object",
          "required": ["labelCount", "sourceId", "file"],
          "properties": {
            "labelCount": {"type": "integer", "minimum": 0},
            "sourceId": {"type": "string"},
            "file": {"$ref": "#/$defs/fileMetadata"}
          }
        }
      }
    },
    "navigationMap": {
      "type": "object",
      "required": [
        "renderer",
        "style",
        "archiveFormat",
        "tileArchive",
        "manifest",
        "requiredLayers",
        "overlayLayers",
        "attributionVisible"
      ],
      "properties": {
        "renderer": {"const": "FlyingOfflineNavigationMapWidget"},
        "style": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*://).+$"
        },
        "archiveFormat": {"enum": ["pmtiles", "mbtiles"]},
        "tileArchive": {"$ref": "#/$defs/fileMetadata"},
        "manifest": {"$ref": "#/$defs/fileMetadata"},
        "requiredLayers": {
          "type": "array",
          "contains": {"const": "zabaged-base"},
          "allOf": [
            {"contains": {"const": "geonames-labels"}},
            {"contains": {"const": "airports"}},
            {"contains": {"const": "runways"}},
            {"contains": {"const": "obstacles"}},
            {"contains": {"const": "airspaces"}}
          ]
        },
        "overlayLayers": {
          "type": "array",
          "contains": {"const": "aircraft-position"},
          "allOf": [
            {"contains": {"const": "flight-path"}},
            {"contains": {"const": "replay-track"}}
          ]
        },
        "attributionVisible": {"const": true}
      }
    },
    "masks": {
      "type": "object",
      "required": ["grid", "waterMask", "materialMask"],
      "properties": {
        "grid": {"type": "object"},
        "waterMask": {"$ref": "#/$defs/fileMetadata"},
        "materialMask": {"$ref": "#/$defs/fileMetadata"}
      }
    },
    "streaming": {
      "type": "object",
      "required": [
        "runtimeNetworkRequired",
        "externalMapApis",
        "remoteTileServerUrls",
        "addressing",
        "coverageScope",
        "interruptionFreeWithinDeclaredBounds"
      ],
      "properties": {
        "runtimeNetworkRequired": {"const": false},
        "externalMapApis": {"type": "array", "maxItems": 0},
        "remoteTileServerUrls": {"type": "array", "maxItems": 0},
        "addressing": {"type": "string", "minLength": 1},
        "coverageScope": {"enum": ["pilot-region", "czech-republic"]},
        "interruptionFreeWithinDeclaredBounds": {"const": true}
      }
    },
    "packagingLayout": {
      "type": "object",
      "required": [
        "imageryRoot",
        "vectorRoot",
        "maskRoot",
        "orthoTileCount",
        "vectorLayerCount",
        "waterMaskAvailable",
        "materialMaskAvailable",
        "imageryBytes",
        "vectorBytes",
        "maskBytes",
        "totalBytes"
      ],
      "properties": {
        "imageryRoot": {"const": "imagery"},
        "vectorRoot": {"const": "vectors"},
        "maskRoot": {"const": "masks"},
        "orthoTileCount": {"type": "integer", "minimum": 1},
        "vectorLayerCount": {"type": "integer", "minimum": 6},
        "waterMaskAvailable": {"const": true},
        "materialMaskAvailable": {"const": true},
        "imageryBytes": {"type": "integer", "minimum": 1},
        "vectorBytes": {"type": "integer", "minimum": 1},
        "maskBytes": {"type": "integer", "minimum": 1},
        "totalBytes": {"type": "integer", "minimum": 1}
      }
    },
    "validation": {
      "type": "object",
      "required": ["offlineRuntime"],
      "properties": {
        "offlineRuntime": {
          "type": "object",
          "required": [
            "externalMapApiKeys",
            "remoteTileServerUrls",
            "passed"
          ],
          "properties": {
            "externalMapApiKeys": {"const": 0},
            "remoteTileServerUrls": {"const": 0},
            "passed": {"const": true}
          }
        }
      }
    }
  },
  "$defs": {
    "fileMetadata": {
      "type": "object",
      "required": ["id", "path", "checksum", "sizeBytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "checksum": {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "value": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
          }
        },
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    },
    "assetTile": {
      "type": "object",
      "required": [
        "tileId",
        "row",
        "col",
        "widthPx",
        "heightPx",
        "sourceId",
        "bounds",
        "file"
      ],
      "properties": {
        "tileId": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0},
        "widthPx": {"type": "integer", "minimum": 1},
        "heightPx": {"type": "integer", "minimum": 1},
        "sourceId": {"type": "string", "minLength": 1},
        "bounds": {"type": "object"},
        "file": {"$ref": "#/$defs/fileMetadata"}
      }
    }
  }
}
