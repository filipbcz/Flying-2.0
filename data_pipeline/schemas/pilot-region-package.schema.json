{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/pilot-region-package.schema.json",
  "title": "Flying Pilot Region Offline GIS Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "packageName",
    "packageVersion",
    "packageId",
    "contentHash",
    "sourceManifestVersion",
    "sourceLineage",
    "pilotRegion",
    "runtimeDependencies",
    "imagery",
    "vectorPackages",
    "masks",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.pilot-region-package.v1"
    },
    "packageName": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "packageId": {"type": "string", "minLength": 1},
    "contentHash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "sourceManifestVersion": {"type": "string", "minLength": 1},
    "sourceLineage": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "pilotRegion": {"type": "object"},
    "runtimeDependencies": {
      "type": "object",
      "required": [
        "runtimeNetworkRequired",
        "externalMapApis",
        "remoteTileServerUrls"
      ],
      "properties": {
        "runtimeNetworkRequired": {"const": false},
        "externalMapApis": {"type": "array", "maxItems": 0},
        "remoteTileServerUrls": {"type": "array", "maxItems": 0}
      }
    },
    "imagery": {
      "type": "object",
      "required": ["encoding", "tileSizePx", "mipmapped", "lods"],
      "properties": {
        "encoding": {"const": "ppm-p3"},
        "tileSizePx": {"type": "integer", "minimum": 1},
        "mipmapped": {"type": "boolean"},
        "lods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["level", "sourcePixelScale", "tiles"],
            "properties": {
              "level": {"type": "integer", "minimum": 0},
              "sourcePixelScale": {"type": "integer", "minimum": 1},
              "tiles": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/assetTile"}
              }
            }
          }
        }
      }
    },
    "vectorPackages": {
      "type": "object",
      "required": ["coordinateFrame", "layers", "labels"],
      "properties": {
        "coordinateFrame": {"const": "project-local-ENU"},
        "layers": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": ["category", "featureCount", "sourceId", "file"],
            "properties": {
              "category": {"type": "string"},
              "featureCount": {"type": "integer", "minimum": 0},
              "sourceId": {"type": "string"},
              "file": {"$ref": "#/$defs/fileMetadata"}
            }
          }
        },
        "labels": {
          "type": "object",
          "required": ["labelCount", "sourceId", "file"],
          "properties": {
            "labelCount": {"type": "integer", "minimum": 0},
            "sourceId": {"type": "string"},
            "file": {"$ref": "#/$defs/fileMetadata"}
          }
        }
      }
    },
    "masks": {
      "type": "object",
      "required": ["grid", "waterMask", "materialMask"],
      "properties": {
        "grid": {"type": "object"},
        "waterMask": {"$ref": "#/$defs/fileMetadata"},
        "materialMask": {"$ref": "#/$defs/fileMetadata"}
      }
    },
    "validation": {
      "type": "object",
      "required": ["offlineRuntime"],
      "properties": {
        "offlineRuntime": {
          "type": "object",
          "required": [
            "externalMapApiKeys",
            "remoteTileServerUrls",
            "passed"
          ],
          "properties": {
            "externalMapApiKeys": {"const": 0},
            "remoteTileServerUrls": {"const": 0},
            "passed": {"const": true}
          }
        }
      }
    }
  },
  "$defs": {
    "fileMetadata": {
      "type": "object",
      "required": ["id", "path", "checksum", "sizeBytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "checksum": {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "value": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
          }
        },
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    },
    "assetTile": {
      "type": "object",
      "required": [
        "tileId",
        "row",
        "col",
        "widthPx",
        "heightPx",
        "sourceId",
        "bounds",
        "file"
      ],
      "properties": {
        "tileId": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0},
        "widthPx": {"type": "integer", "minimum": 1},
        "heightPx": {"type": "integer", "minimum": 1},
        "sourceId": {"type": "string", "minLength": 1},
        "bounds": {"type": "object"},
        "file": {"$ref": "#/$defs/fileMetadata"}
      }
    }
  }
}
