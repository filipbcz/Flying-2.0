{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/long-flight-soak-report.schema.json",
  "title": "Flying long-flight soak report",
  "type": "object",
  "required": [
    "schemaVersion",
    "scenarioId",
    "durationHoursRequired",
    "durationHoursActual",
    "identity",
    "process",
    "memorySamples",
    "hitches",
    "streamingErrors",
    "replayHashes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "flying.long-flight-soak-report.v1"
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "startedAtUtc": {
      "type": "string"
    },
    "completedAtUtc": {
      "type": [
        "string",
        "null"
      ]
    },
    "durationHoursRequired": {
      "type": "number",
      "minimum": 10
    },
    "durationHoursActual": {
      "type": "number",
      "minimum": 0
    },
    "identity": {
      "type": "object",
      "required": [
        "coreSimVersion",
        "dataVersion",
        "configVersion",
        "inputProfile",
        "weatherSeed"
      ],
      "properties": {
        "coreSimVersion": {
          "type": "string",
          "minLength": 1
        },
        "dataVersion": {
          "type": "string",
          "minLength": 1
        },
        "configVersion": {
          "type": "string",
          "minLength": 1
        },
        "inputProfile": {
          "type": "string",
          "minLength": 1
        },
        "weatherSeed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "process": {
      "type": "object",
      "required": [
        "exitCode",
        "crashed"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array"
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "crashed": {
          "type": "boolean"
        }
      }
    },
    "memorySamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capturedAtUtc"
        ],
        "properties": {
          "capturedAtUtc": {
            "type": "string",
            "minLength": 1
          },
          "residentMiB": {
            "type": "number",
            "minimum": 0
          },
          "workingSetMiB": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "hitches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "durationMilliseconds"
        ],
        "properties": {
          "durationMilliseconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "streamingErrors": {
      "type": "array"
    },
    "replayHashes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "scenarioId",
          "coreSimVersion",
          "dataVersion",
          "configVersion",
          "inputProfile",
          "weatherSeed",
          "hash"
        ],
        "properties": {
          "scenarioId": {
            "type": "string",
            "minLength": 1
          },
          "coreSimVersion": {
            "type": "string",
            "minLength": 1
          },
          "dataVersion": {
            "type": "string",
            "minLength": 1
          },
          "configVersion": {
            "type": "string",
            "minLength": 1
          },
          "inputProfile": {
            "type": "string",
            "minLength": 1
          },
          "weatherSeed": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  }
}
