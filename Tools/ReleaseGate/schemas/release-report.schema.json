{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flying.local/schemas/release-report.schema.json",
  "title": "Flying release report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "visualAcceptance", "cleanInstallWorkflow", "mandatoryChecks"],
  "properties": {
    "schemaVersion": {
      "const": "flying.release-report.v1"
    },
    "status": {
      "enum": ["complete", "partial", "blocked"]
    },
    "visualAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "evidenceManifest",
        "mandatoryScenes",
        "baselineApproval",
        "placeholderScan",
        "result"
      ],
      "properties": {
        "required": {"const": true},
        "evidenceManifest": {"type": "string", "minLength": 1},
        "mandatoryScenes": {
          "type": "array",
          "items": {
            "enum": [
              "cockpit_day_readability",
              "cockpit_night_lighting",
              "cold_and_dark_cockpit",
              "engine_start_cockpit",
              "aircraft_exterior",
              "taxi_runway_signs_lights",
              "takeoff_aircraft_exterior",
              "cross_country_regional_world",
              "low_pass_built_region",
              "low_pass_natural_region",
              "cloudy_precipitation_weather",
              "sunrise_sunset_lighting",
              "approach_landing_airport",
              "shutdown_cockpit",
              "replay_review",
              "telemetry_export_review"
            ]
          },
          "uniqueItems": true,
          "minItems": 16
        },
        "baselineApproval": {"const": "approved"},
        "placeholderScan": {"const": "pass"},
        "result": {"const": "pass"}
      }
    },
    "releaseCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "configuration", "signedBuildRequired", "installerRequired"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "platform": {"const": "Win64"},
        "configuration": {"const": "Shipping"},
        "signedBuildRequired": {"const": true},
        "installerRequired": {"const": true},
        "regionalPackagesRequired": {"const": true}
      }
    },
    "cleanInstallWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "environment", "phases", "requiredEvidence", "result"],
      "properties": {
        "required": {"const": true},
        "environment": {
          "type": "object",
          "additionalProperties": true,
          "required": ["os", "regionPackage", "networkState"],
          "properties": {
            "os": {"const": "Windows 11"},
            "regionPackage": {"type": "string", "minLength": 1},
            "regionManifest": {"type": "string", "minLength": 1},
            "networkState": {"type": "string", "minLength": 1}
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "enum": [
              "install signed Shipping build",
              "select offline region package",
              "install regional data root",
              "verify regional data availability",
              "start cold-and-dark at included airport",
              "start engine",
              "taxi",
              "takeoff",
              "navigate cross-country in selected region",
              "land at another included airport",
              "shutdown",
              "replay flight",
              "export telemetry"
            ]
          },
          "uniqueItems": true,
          "minItems": 13
        },
        "requiredEvidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidenceArtifacts": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "result": {"enum": ["pass", "fail", "blocked"]}
      }
    },
    "dependencyGates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mandatory", "releaseBlocking", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "releaseBlocking": {"type": "boolean"},
          "result": {"enum": ["pass", "fail", "blocked", "missing"]},
          "evidence": {"type": "string", "minLength": 1},
          "knownLimitation": {"type": "string", "minLength": 1}
        }
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "releaseImpact", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["accepted", "blocked"]},
          "releaseImpact": {"enum": ["none", "partial", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "approvedBy"],
      "properties": {
        "decision": {"enum": ["complete", "partial", "blocked"]},
        "reason": {"type": "string", "minLength": 1},
        "approvedBy": {"type": ["string", "null"]}
      }
    },
    "mandatoryChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mandatory", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "result": {"enum": ["pass", "fail", "blocked"]}
        }
      }
    }
  }
}
