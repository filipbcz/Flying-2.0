{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "development",
      "displayName": "Development",
      "description": "Debug native build with smoke-test targets enabled.",
      "binaryDir": "${sourceDir}/out/build/development",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FLYING_BUILD_TESTS": "ON",
        "FLYING_RUNTIME_NETWORK": "OFF",
        "FLYING_REQUIRE_MAP_API_KEYS": "OFF",
        "FLYING_PACKAGE_WIN64": "OFF"
      }
    },
    {
      "name": "test",
      "displayName": "Test",
      "description": "Narrow native validation build for CI and local smoke testing.",
      "binaryDir": "${sourceDir}/out/build/test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FLYING_BUILD_TESTS": "ON",
        "FLYING_RUNTIME_NETWORK": "OFF",
        "FLYING_REQUIRE_MAP_API_KEYS": "OFF",
        "FLYING_PACKAGE_WIN64": "OFF"
      }
    },
    {
      "name": "jsbsim-validation",
      "displayName": "JSBSim Adapter Validation",
      "description": "Requires JSBSim so CoreSim adapter repeatability coverage cannot be skipped.",
      "binaryDir": "${sourceDir}/out/build/jsbsim-validation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FLYING_BUILD_TESTS": "ON",
        "FLYING_RUNTIME_NETWORK": "OFF",
        "FLYING_REQUIRE_MAP_API_KEYS": "OFF",
        "FLYING_PACKAGE_WIN64": "OFF",
        "FLYING_CORE_SIM_ENABLE_JSBSIM": "ON",
        "FLYING_CORE_SIM_REQUIRE_JSBSIM": "ON",
        "FLYING_CORE_SIM_FETCH_JSBSIM": "ON"
      }
    },
    {
      "name": "win64-packaging",
      "displayName": "Win64 Packaging",
      "description": "Release native configuration for future Windows x64 package assembly.",
      "binaryDir": "${sourceDir}/out/build/win64-packaging",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FLYING_BUILD_TESTS": "ON",
        "FLYING_RUNTIME_NETWORK": "OFF",
        "FLYING_REQUIRE_MAP_API_KEYS": "OFF",
        "FLYING_PACKAGE_WIN64": "ON",
        "FLYING_TARGET_PLATFORM": "Win64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "development",
      "displayName": "Build Development",
      "configurePreset": "development",
      "configuration": "Debug"
    },
    {
      "name": "test",
      "displayName": "Build Test",
      "configurePreset": "test",
      "configuration": "Debug"
    },
    {
      "name": "smoke",
      "displayName": "Build Smoke Test Targets",
      "configurePreset": "test",
      "configuration": "Debug",
      "targets": [
        "flying_skeleton_smoke",
        "flying_data_pipeline_cli",
        "flying_data_pipeline_manifest_tests",
        "flying_data_pipeline_dmr5g_terrain_tests",
        "flying_data_pipeline_pilot_region_package_tests",
        "flying_data_pipeline_airport_database_tests",
        "flying_data_pipeline_runway_importer_tests",
        "flying_core_sim_kernel_tests",
        "flying_core_sim_determinism_tests",
        "flying_core_sim_flight_dynamics_api_tests",
        "flying_core_sim_aircraft_config_tests",
        "flying_core_sim_aircraft_systems_tests",
        "flying_core_sim_input_mapping_tests",
        "flying_core_sim_scenario_start_tests",
        "flying_core_sim_telemetry_replay_tests",
        "flying_core_sim_terrain_contact_tests",
        "flying_core_sim_weather_tests",
        "flying_geo_terrain_geodesy_units_tests",
        "flying_geodesy_reference_tests",
        "flying_geo_terrain_terrain_service_tests",
        "flying_terrain_runtime_tests",
        "flying_m1_vertical_slice_tests"
      ]
    },
    {
      "name": "jsbsim-validation",
      "displayName": "Build JSBSim Adapter Validation",
      "configurePreset": "jsbsim-validation",
      "configuration": "Debug"
    },
    {
      "name": "win64-packaging",
      "displayName": "Build Win64 Packaging",
      "configurePreset": "win64-packaging",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "smoke",
      "displayName": "Smoke Tests",
      "configurePreset": "test",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "smoke"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "soak",
      "displayName": "Soak Tests",
      "configurePreset": "test",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "soak"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "jsbsim-adapter",
      "displayName": "JSBSim Adapter Tests",
      "configurePreset": "jsbsim-validation",
      "configuration": "Debug",
      "filter": {
        "include": {
          "name": "^flying\\.core_sim\\.jsbsim_adapter$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "m1-vertical-slice",
      "displayName": "M1 Vertical Slice Tests",
      "configurePreset": "test",
      "configuration": "Debug",
      "filter": {
        "include": {
          "label": "m1-vertical-slice"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "local-validation",
      "displayName": "Configure, build, and smoke test",
      "steps": [
        {
          "type": "configure",
          "name": "test"
        },
        {
          "type": "build",
          "name": "smoke"
        },
        {
          "type": "test",
          "name": "smoke"
        }
      ]
    },
    {
      "name": "jsbsim-validation",
      "displayName": "Configure, build, and test JSBSim adapter",
      "steps": [
        {
          "type": "configure",
          "name": "jsbsim-validation"
        },
        {
          "type": "build",
          "name": "jsbsim-validation"
        },
        {
          "type": "test",
          "name": "jsbsim-adapter"
        }
      ]
    }
  ]
}
